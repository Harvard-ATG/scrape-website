                  <source srcset="/sites/g/files/omnuum4426/files/styles/hwp_28_10__1920x685/public/2024-11/abou2.jpg?itok=bNcMfn19 1x, /sites/g/files/omnuum4426/files/styles/hwp_28_10__3840x1370/public/2024-11/abou2.jpg?itok=hcqbXTQj 2x" media="all and (min-width: 1440px)" type="image/jpeg" width="1920" height="685"/>
              <source srcset="/sites/g/files/omnuum4426/files/styles/hwp_28_10__1440x510/public/2024-11/abou2.jpg?itok=IF-OHYHm 1x, /sites/g/files/omnuum4426/files/styles/hwp_28_10__2880x1030/public/2024-11/abou2.jpg?itok=R4JSsNu3 2x" media="all and (min-width: 1024px)" type="image/jpeg" width="1440" height="510"/>
              <source srcset="/sites/g/files/omnuum4426/files/styles/hwp_28_10__1024x365/public/2024-11/abou2.jpg?itok=NZPmAe13 1x, /sites/g/files/omnuum4426/files/styles/hwp_28_10__2048x730/public/2024-11/abou2.jpg?itok=OpG6D8h4 2x" media="all and (min-width: 768px)" type="image/jpeg" width="1024" height="365"/>
              <source srcset="/sites/g/files/omnuum4426/files/styles/hwp_28_10__768x275/public/2024-11/abou2.jpg?itok=4G2kKcG3 1x, /sites/g/files/omnuum4426/files/styles/hwp_28_10__1536x550/public/2024-11/abou2.jpg?itok=KDb6LY0E 2x" media="all and (min-width: 480px)" type="image/jpeg" width="768" height="275"/>
